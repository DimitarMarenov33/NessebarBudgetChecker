# Copy this file to .env and fill in real values. .env is git-ignored.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DATABASE_URL=sqlite:///data/nessebar.db

DATA_DIR=data

# Base URL the static site is published at (GitHub Pages). Used by the site
# generator (nessebar_budget.web.build) for absolute links/canonical URLs.
# In CI this is set from the repo/org "SITE_BASE_URL" Actions variable
# instead (Settings -> Secrets and variables -> Actions -> Variables); this
# local default only matters for `nessebar build-site` run by hand.
SITE_BASE_URL=https://dimitarmarenov33.github.io/NessebarBudgetChecker
